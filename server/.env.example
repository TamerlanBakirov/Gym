# Copy to .env and adjust as needed.

# Server
PORT=4000
NODE_ENV=development

# Database. By default the app uses SQLite at DATABASE_PATH.
# Set DATABASE_URL to use Postgres instead (takes precedence over DATABASE_PATH).
DATABASE_PATH=data/forge.db
# DATABASE_URL=postgres://forge:forge@localhost:5432/forge

# JWT secrets — CHANGE THESE in production.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated list of allowed CORS origins. Use * for any (dev only).
CORS_ORIGIN=*
