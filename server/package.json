{
  "name": "forge-server",
  "version": "1.0.0",
  "description": "Forge fitness app backend — Express + node:sqlite + JWT",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --experimental-sqlite --disable-warning=ExperimentalWarning --watch --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs');fs.mkdirSync('dist/db',{recursive:true});for(const f of fs.readdirSync('src/db').filter(f=>f.endsWith('.sql')))fs.copyFileSync('src/db/'+f,'dist/db/'+f)\"",
    "start": "node --experimental-sqlite --disable-warning=ExperimentalWarning dist/index.js",
    "seed": "node --experimental-sqlite --disable-warning=ExperimentalWarning --import tsx src/db/seed.ts",
    "test": "node --experimental-sqlite --disable-warning=ExperimentalWarning --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0"
  }
}
